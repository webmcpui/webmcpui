{
  "name": "@webmcpui/core",
  "version": "0.4.0",
  "description": "Agent-aware, framework-agnostic web components for the WebMCP era — accessible, form-associated controls an AI agent can fill, with Standard Schema validation.",
  "license": "MIT",
  "author": "Gary Pfaff (Pfaff Digital)",
  "homepage": "https://webmcpui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webmcpui/webmcpui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/webmcpui/webmcpui/issues"
  },
  "keywords": [
    "webmcp",
    "web-components",
    "custom-elements",
    "ai-agents",
    "modelcontext",
    "forms",
    "standard-schema",
    "lit"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "unpkg": "./dist/webmcpui.global.js",
  "jsdelivr": "./dist/webmcpui.global.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/append-global-dts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "wtr && pnpm run test:node",
    "test:watch": "wtr --watch",
    "test:node": "pnpm run build && node --conditions=browser --test 'test/node/*.test.mjs'",
    "test:smoke": "node scripts/smoke.mjs",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@webmcpui/webmcp": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@open-wc/testing": "^5.0.0",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "zod": "^4.5.4"
  }
}
